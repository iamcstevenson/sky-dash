# Checks GitHub for new commits on main every 5 minutes, so a merge goes live by itself.
[Unit]
Description=Skydash auto-update check

[Timer]
# A fixed clock schedule: a boot-relative one (OnBootSec) never fired on a server that had
# booted long before the timer was installed.
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
