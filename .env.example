# Copy this file to .env and fill it in.
# Use APP PASSWORDS, not your real passwords:
# Bluesky → Settings → Privacy and Security → App Passwords

ACCOUNT_1_HANDLE=you.bsky.social
ACCOUNT_1_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

ACCOUNT_2_HANDLE=your-other.bsky.social
ACCOUNT_2_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Only change these if your accounts are on a self-hosted PDS
# ACCOUNT_1_SERVICE=https://bsky.social
# ACCOUNT_2_SERVICE=https://bsky.social

# Dashboard address. Keep it on 127.0.0.1; use `tailscale serve` for phone access.
PORT=4747
HOST=127.0.0.1

# How far back the unified feed goes, and how long posts are kept on disk
FEED_HOURS=72
RETENTION_DAYS=15

# Keyword feed: how far back it goes, and how often each keyword is re-searched
KEYWORD_HOURS=48
KEYWORD_POLL_MINUTES=2

# Optional: publish your keyword feed in the Bluesky app.
# Set this to your Tailscale Funnel name after running `tailscale funnel --bg 4748`.
# FEEDGEN_HOSTNAME=your-mac.tail1234.ts.net
# FEEDGEN_PORT=4748
